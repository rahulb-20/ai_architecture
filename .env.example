# Copy to .env (never commit .env). Every variable is optional: defaults run fully offline.
AIARCH_ENV=local
AIARCH_LOG_LEVEL=INFO

# Ordered fallback chain. First healthy route wins. Keys are read from the env var named in api_key_env.
# Local Ollama first, offline fake as last resort:
# AIARCH_LLM_ROUTES=[{"name":"ollama","base_url":"http://localhost:11434/v1","model":"llama3.2:3b","timeout_s":60},{"name":"fake","kind":"fake"}]
# OpenAI / Azure OpenAI (v1) / any LiteLLM gateway fronting Anthropic, Gemini or watsonx.ai:
# AIARCH_LLM_ROUTES=[{"name":"primary","base_url":"https://api.openai.com/v1","model":"<model>","api_key_env":"OPENAI_API_KEY"},{"name":"gateway","base_url":"http://localhost:4000/v1","model":"<model>","api_key_env":"LITELLM_KEY"}]
# OPENAI_API_KEY=
# LITELLM_KEY=

# hashing (offline, default) | sentence-transformers (pip install -e ".[local-models]")
AIARCH_EMBEDDER=hashing
AIARCH_SEMANTIC_CACHE=true
# true = do not mask PII-shaped values in an answer when they appear verbatim in the cited sources
AIARCH_OUTPUT_KEEP_SOURCE_PII=false
AIARCH_CACHE_THRESHOLD=0.92
AIARCH_K_FINAL=5
AIARCH_MAX_INPUT_TOKENS=12000

# Comma-separated API keys for the HTTP API. Empty = auth off (local only).
AIARCH_API_KEYS=
